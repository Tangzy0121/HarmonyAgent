{
  "name": "loci-demo-video",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "remotion studio src/index.ts",
    "build": "remotion bundle src/index.ts",
    "render": "remotion render src/index.ts LociDemo out/loci-demo.mp4",
    "render:cover": "remotion still src/index.ts LociDemo out/loci-demo-cover.png --frame=0",
    "capture": "node scripts/capture-states.mjs",
    "validate": "node scripts/validate-assets.mjs"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.498",
    "@remotion/cli": "4.0.498",
    "@remotion/player": "4.0.498"
  },
  "devDependencies": {
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "typescript": "5.5.3"
  }
}
